# Token GitHub fine-grained : Contents=Read, Deployments=Read/Write, Commit statuses=Read/Write
GITHUB_TOKEN=
# Secret partagé, >= 16 caractères. Génère : python -c "import secrets;print(secrets.token_hex(24))"
WEBHOOK_SECRET=
# Clé API Dokploy (Settings -> API/Swagger). Suffit à retrouver le repo de CHAQUE app.
DOKPLOY_API_KEY=

# --- Optionnel ---
# Forcer l'URL Dokploy (sinon déduite automatiquement de la notification)
DOKPLOY_URL=
# Branche par défaut si Dokploy n'en renvoie pas
GITHUB_BRANCH=main
# Fallbacks si tu n'utilises PAS l'API Dokploy :
GITHUB_OWNER=
APP_MAP=
# Optionnel : active le statut "en cours" via un webhook GitHub push (secret au choix)
GITHUB_WEBHOOK_SECRET=

# Statut "en cours" AUTO (recommandé) : le service surveille l'API Dokploy.
# Renseigne DOKPLOY_URL pour que ça démarre dès le boot. POLL=off pour désactiver.
POLL=on
POLL_INTERVAL_MS=5000
