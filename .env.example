# Token GitHub fine-grained : Contents=Read, Deployments=Read/Write, Commit statuses=Read/Write
GITHUB_TOKEN=
# Secret partagé, >= 16 caractères. Génère : python -c "import secrets;print(secrets.token_hex(24))"
WEBHOOK_SECRET=
# Ton compte/orga GitHub : on suppose que le repo porte le meme nom que l'app Dokploy
GITHUB_OWNER=
# Branche suivie (defaut: main)
GITHUB_BRANCH=main
# Optionnel, exceptions quand nom d'app != nom de repo :
# APP_MAP={"mon-app-dokploy":"mv1234vm/mon-repo","autre":"mv1234vm/autre-repo@master"}
APP_MAP=
